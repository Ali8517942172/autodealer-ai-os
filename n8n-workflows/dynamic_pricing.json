{
  "id": "LphiGg4iqF1bn6El",
  "name": "Competitor Price Scraping & Supabase Update",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "e1f13b65-0a88-4444-a0ab-48e0c8bdf92a",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        224,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// The Supabase 'inventory' table has: id, model, vin, status, days_in_stock,\n// price_aed, cost_aed, gross_margin, ... There is no brand/make/year column,\n// so build the search query from what actually exists.\nconst item = $json;\nconst model = String(item.model || '').trim();\n\nif (!model) {\n  // Nothing searchable - skip this row rather than querying 'undefined UAE price'\n  return [];\n}\n\nreturn [{ json: {\n  id: item.id,\n  model: model,\n  vin: item.vin || null,\n  localPrice: Number(item.price_aed) || null,\n  daysInStock: Number(item.days_in_stock) || 0,\n  searchQuery: `${model} price UAE dealership`\n} }];"
      },
      "id": "a7af0b27-7266-4f26-be34-d943fd45566c",
      "name": "Build Apify Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~rag-web-browser/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $json.searchQuery, maxResults: 3, outputFormats: ['markdown'] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "cd288bec-24e5-4660-ac8d-2f35bfda0290",
      "name": "Apify - Search Competitor Price",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1040,
        128
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpQueryAuth": {
          "id": "NBPWuHrq7fLlfHvT",
          "name": "Apify account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'google/gemini-2.5-flash', max_tokens: 300, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You are a pricing data extraction assistant. Given scraped web content about a vehicle, extract the lowest advertised price in AED as a plain number. Respond with ONLY valid JSON: {\"price\": <number or null>, \"currency\": \"AED\", \"source\": \"<domain or site name>\"}. If no clear price is found, return null for price.' }, { role: 'user', content: 'Vehicle: ' + $('Build Apify Query').item.json.model + '\\n\\nScraped content:\\n' + (Array.isArray($json) ? ($json[0] && ($json[0].markdown || $json[0].text) || 'No content found') : ($json.markdown || $json.text || JSON.stringify($json))).substring(0, 6000) } ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "774f32ec-c606-4040-ae64-606ef0704556",
      "name": "Extract Price with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1264,
        128
      ],
      "credentials": {
        "openRouterApi": {
          "id": "UUtKrBzkQOztAOzZ",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst original = $('Build Apify Query').item.json;\n\nlet parsed = { price: null };\ntry {\n  parsed = JSON.parse(response.choices?.[0]?.message?.content || '{}');\n} catch (e) { /* keep default */ }\n\nconst competitorPrice = (typeof parsed.price === 'number' && parsed.price > 0) ? parsed.price : null;\nconst localPrice = original.localPrice;\n\nreturn [{ json: {\n  id: original.id,\n  model: original.model,\n  localPrice: localPrice,\n  competitorPrice: competitorPrice,\n  priceDiff: (competitorPrice !== null && localPrice !== null) ? (competitorPrice - localPrice) : null,\n  competitorSource: parsed.source || null,\n  currency: parsed.currency || 'AED',\n  daysInStock: original.daysInStock\n} }];"
      },
      "id": "172a82ea-c373-49db-ac3b-51ffb95150ae",
      "name": "Parse AI Price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{$json.competitorPrice}}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists"
              }
            },
            {
              "id": "cond2",
              "leftValue": "={{$json.competitorPrice}}",
              "rightValue": "={{$json.localPrice}}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "c083aa22-d551-478e-a3d7-c38460e30848",
      "name": "Should Update Price?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1712,
        128
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "model",
              "value": "={{ $json.model }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "oldPrice",
              "value": "={{ $json.localPrice }}",
              "type": "number"
            },
            {
              "id": "a4",
              "name": "price",
              "value": "={{ Math.max(0, Math.round($json.competitorPrice - 1)) }}",
              "type": "number"
            },
            {
              "id": "a5",
              "name": "competitorSource",
              "value": "={{ $json.competitorSource }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "competitorPrice",
              "value": "={{ $json.competitorPrice }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "3fd28eb1-a870-459a-9b64-5d9b96b1265a",
      "name": "Build Update Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1920,
        128
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "inventory",
        "returnAll": true
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        560,
        128
      ],
      "id": "8daa883b-cf45-4e2f-b329-9b12f71e4a68",
      "name": "Fetch Local Inventory",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "inventory",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "price_aed",
              "fieldValue": "={{ $json.price }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2144,
        128
      ],
      "id": "266f7fd3-e685-44e6-9200-075128bb2a97",
      "name": "Update Prices in Supabase",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "882f5cb9-92fc-45d9-81d4-2454a8a454f9",
      "name": "Log Competitor Intel",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1712,
        320
      ],
      "parameters": {
        "tableId": "competitors",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "competitor",
              "fieldValue": "={{ $json.competitorSource || 'unknown' }}"
            },
            {
              "fieldId": "model",
              "fieldValue": "={{ $json.model }}"
            },
            {
              "fieldId": "price_aed",
              "fieldValue": "={{ $json.competitorPrice }}"
            },
            {
              "fieldId": "our_price_aed",
              "fieldValue": "={{ $json.localPrice }}"
            },
            {
              "fieldId": "price_diff_aed",
              "fieldValue": "={{ $json.priceDiff }}"
            },
            {
              "fieldId": "ai_recommendation",
              "fieldValue": "={{ $json.competitorPrice === null ? 'No competitor price found' : ($json.priceDiff < 0 ? 'UNDERCUT: competitor is AED ' + Math.abs($json.priceDiff) + ' cheaper. Consider matching, especially at ' + $json.daysInStock + ' days in stock.' : 'HOLD: we are already AED ' + $json.priceDiff + ' cheaper than this competitor.') }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Local Inventory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Apify Query": {
      "main": [
        [
          {
            "node": "Apify - Search Competitor Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apify - Search Competitor Price": {
      "main": [
        [
          {
            "node": "Extract Price with AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Price with AI": {
      "main": [
        [
          {
            "node": "Parse AI Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse AI Price": {
      "main": [
        [
          {
            "node": "Should Update Price?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log Competitor Intel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Update Price?": {
      "main": [
        [
          {
            "node": "Build Update Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Update Payload": {
      "main": [
        [
          {
            "node": "Update Prices in Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Local Inventory": {
      "main": [
        [
          {
            "node": "Build Apify Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "binaryMode": "separate",
    "timezone": "Asia/Dubai",
    "saveDataErrorExecution": "all"
  }
}
