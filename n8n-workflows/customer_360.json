    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BITRIX24_WEBHOOK_URL }}crm.lead.list.json",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ select: ['ID','TITLE','NAME','LAST_NAME','EMAIL','PHONE'], order: { ID: 'DESC' }, start: 0 }) }}",
        "options": {
