        }
      },
      "id": "c360-bitrix-01",
      "name": "Bitrix24 - Get Customers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Bitrix24 returns EMAIL/PHONE as arrays of {VALUE, VALUE_TYPE} objects and\n// omits them entirely when empty. Flatten to a simple customer record.\nconst res = ($json && $json.result) || [];\nconst first = (arr) => Array.isArray(arr) && arr.length ? (arr[0].VALUE || null) : null;\n\nreturn res.map(c => {\n  const name = [c.NAME, c.LAST_NAME].filter(Boolean).join(' ').trim() || c.TITLE || null;\n  return { json: {\n    id: String(c.ID),\n    name: name,\n    email: first(c.EMAIL),\n    phone: first(c.PHONE)\n  } };\n}).filter(i => i.json.email || i.json.phone);"
      },
      "id": "c360-norm-01",
      "name": "Normalise Bitrix Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        576
      ]
    },
    {
