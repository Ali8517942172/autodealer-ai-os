    },
    {
      "parameters": {
        "jsCode": "// Aggregate everything we know about the customer currently in the loop.\nconst customer = $('Split In Batches').first().json;\n\nlet emails = [];\ntry {\n  emails = $('Gmail - Get Emails').all().filter(i => i.json && i.json.id);\n} catch (e) { emails = []; }\n\nlet slackMessages = [];\ntry {\n  slackMessages = $('Slack - Search Mentions').all().filter(i => i.json && (i.json.ts || i.json.text));\n} catch (e) { slackMessages = []; }\n\n// Odoo returns boolean false for empty char fields - normalise to null.\nconst clean = (v) => (v === false || v === 'false' || v === '' || v === undefined) ? null : v;\n\nreturn [{\n  json: {\n    customer_id: String(customer.id),\n    name: clean(customer.name),\n    email: clean(customer.email),\n    phone: clean(customer.phone),\n    total_emails: emails.length,\n    total_slack_messages: slackMessages.length,\n    last_synced_at: new Date().toISOString()\n  }\n}];"
      },
      "name": "Transform & Unify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
