    {
      "parameters": {
        "mode": "chooseBranch"
      },
      "name": "Merge Customer Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        880,
        304
      ],
      "id": "7537a90b-2b10-49fa-9407-591423af725d"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate everything we know about the customer currently in the loop.\nconst customer = $('Split In Batches').first().json;\n\nlet emails = [];\ntry {\n  emails = $('Gmail - Get Emails').all().filter(i => i.json && i.json.id);\n} catch (e) { emails = []; }\n\nlet slackMessages = [];\ntry {\n  slackMessages = $('Slack - Search Mentions').all().filter(i => i.json && (i.json.ts || i.json.text));\n} catch (e) { slackMessages = []; }\n\n// Bitrix24 returns false/empty for missing fields - normalise to null.\nconst clean = (v) => (v === false || v === 'false' || v === '' || v === undefined) ? null : v;\n\nreturn [{\n  json: {\n    customer_id: String(customer.id),\n    name: clean(customer.name),\n    email: clean(customer.email),\n    phone: clean(customer.phone),\n    total_emails: emails.length,\n    total_slack_messages: slackMessages.length,\n    last_synced_at: new Date().toISOString()\n  }\n}];"
      },
      "name": "Transform & Unify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        304
      ],
      "id": "5f9b532c-ad0d-4067-b591-10a14852cfae"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dsvuoovivysszdoiorch.supabase.co/rest/v1/customer_360_profiles",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "customer_id"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Supabase - Upsert Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1328,
