{
  "id": "BiyHk9ZXxJUVGbf6",
  "name": "WhatsApp BDC AI Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "waha-webhook",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "1",
      "name": "WAHA Webhook (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Two entry paths:\n//  1) real WAHA webhook       -> item.body.payload.{body,from}\n//  2) Master Router WARM lead -> item.lead.{name,phone,email,vehicle_interest}\nconst item = $input.first().json;\n\nlet message = '';\nlet sender = '';\nlet leadEmail = null;\nlet direction = 'inbound';\n\nif (item.body && item.body.payload) {\n  message = item.body.payload.body || '';\n  sender = item.body.payload.from || '';\n} else if (item.lead) {\n  const lead = item.lead;\n  const interest = lead.vehicle_interest || lead.vehicleInterest || lead.message || 'a vehicle';\n  message = 'INITIAL_OUTREACH: Lead name: ' + (lead.name || 'there') +\n            ', interested in: ' + interest +\n            '. Send them a warm, personalised WhatsApp welcome message introducing the NEXUS OS dealership and asking how you can help.';\n  sender = lead.phone || lead.whatsapp || '';\n  leadEmail = lead.email || null;\n  direction = 'outbound';\n} else {\n  throw new Error('Unrecognised payload for WhatsApp BDC. Keys: ' + Object.keys(item).join(', '));\n}\n\nif (!sender) {\n  throw new Error('No WhatsApp recipient could be determined from the payload.');\n}\n\n// WAHA expects a chatId like 971500000000@c.us\nlet chatId = String(sender).trim();\nif (!chatId.includes('@')) {\n  chatId = chatId.replace(/[^0-9]/g, '') + '@c.us';\n}\n\nreturn [{ json: { message, sender: chatId, lead_email: leadEmail, direction } }];"
      },
      "id": "2",
      "name": "Extract Message & Sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message }}",
        "options": {
          "systemMessage": "You are NEXUS OS BDC Agent for a premium automotive dealership in UAE. You help customers find vehicles, answer questions about pricing & availability, and book test drives. Be bilingual (EN/AR). If the incoming message starts with \"INITIAL_OUTREACH:\", this is a system instruction (not something the customer said) telling you to proactively send a warm, personalized WhatsApp welcome message to a new lead using the details provided."
        }
      },
      "id": "3",
      "name": "AI BDC Sales Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "5",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2,
      "position": [
        528,
        512
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://waha:3000/api/sendText",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chatId: $('Extract Message & Sender').first().json.sender, text: $json.output, session: 'default' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "7",
      "name": "Send Reply via WAHA HTTP API",
      "type": "n8n-nodes-base.httpRequest",
