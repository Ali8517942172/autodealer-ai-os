        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_email: $('Extract Message & Sender').first().json.lead_email || $('Extract Message & Sender').first().json.sender, channel: 'whatsapp', direction: 'outbound', message: $json.output }) }}",
        "options": {}
      },
