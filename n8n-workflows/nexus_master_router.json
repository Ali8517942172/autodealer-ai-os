    {
      "parameters": {
        "jsCode": "// Accept a raw webhook POST (data under .body) or a direct/sub-workflow call.\nconst raw = $input.first().json;\nconst src = raw.body || raw.lead || raw;\n\nconst clean = (v) => (v === undefined || v === null || v === false || v === '') ? null : String(v).trim();\n\nconst email = clean(src.email);\nconst phone = clean(src.phone) || clean(src.whatsapp);\n\nif (!email && !phone) {\n  throw new Error('Rejected: inbound lead has neither an email nor a phone number. Keys received: ' + Object.keys(src).join(', '));\n}\n\nreturn [{\n  json: {\n    lead: {\n      name: clean(src.name) || clean(src.full_name) || 'Unknown',\n      email: email,\n      phone: phone,\n      vehicle_interest: clean(src.vehicle_interest) || clean(src.vehicleInterest) || clean(src.message) || null,\n      budget_aed: src.budget_aed ? Number(src.budget_aed) : null,\n      source: clean(src.source) || 'webhook',\n      received_at: new Date().toISOString()\n    }\n  }\n}];"
      },
      "id": "2",
      "name": "Validate & Enrich Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// The agent usually returns JSON, but often wrapped in ```json fences or with\n// a sentence around it. The old version silently fell back to COLD/0 on any\n// parse failure, which made every single lead look cold.\nconst lead = $('Validate & Enrich Input').first().json.lead;\nconst rawOut = $input.first().json;\nconst text = String(rawOut.output ?? rawOut.text ?? '').trim();\n\nfunction extractJson(s) {\n  if (!s) return null;\n  // 1. straight parse\n  try { return JSON.parse(s); } catch (e) {}\n  // 2. strip markdown code fences\n  const fenced = s.replace(/```(?:json)?/gi, '').trim();\n  try { return JSON.parse(fenced); } catch (e) {}\n  // 3. grab the outermost {...} block\n  const first = fenced.indexOf('{');\n  const last = fenced.lastIndexOf('}');\n  if (first !== -1 && last > first) {\n    try { return JSON.parse(fenced.slice(first, last + 1)); } catch (e) {}\n  }\n  return null;\n}\n\nlet parsed = extractJson(text);\nlet parseFailed = false;\n\nif (!parsed || typeof parsed !== 'object') {\n  parseFailed = true;\n  // Last resort: pull an intent word and a number out of the prose so a\n  // genuinely hot lead is not silently downgraded to COLD.\n  const intentMatch = text.match(/\\b(HOT|WARM|COLD)\\b/i);\n  const scoreMatch = text.match(/\\b(\\d{1,3})\\b/);\n  parsed = {\n    intent: intentMatch ? intentMatch[1].toUpperCase() : 'WARM',\n    score: scoreMatch ? Math.min(100, parseInt(scoreMatch[1], 10)) : 50,\n    reason: 'Agent did not return valid JSON. Raw output: ' + text.substring(0, 300)\n  };\n}\n\nconst intent = String(parsed.intent || '').toUpperCase();\nconst ai_decision = {\n  intent: ['HOT', 'WARM', 'COLD'].includes(intent) ? intent : 'WARM',\n  score: Number.isFinite(Number(parsed.score)) ? Number(parsed.score) : 50,\n  reason: parsed.reason || null,\n  parse_failed: parseFailed\n};\n\nreturn [{ json: { lead, ai_decision } }];"
      },
