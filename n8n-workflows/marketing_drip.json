    {
      "parameters": {
        "jsCode": "// This workflow is invoked two ways:\n//  1) directly via its POST webhook  -> data sits under item.body\n//  2) as a sub-workflow from the Master Router -> data sits under item.lead\n// Normalise both into a flat { name, email, phone, vehicle_interest }.\nconst item = $input.first().json;\n\nlet lead;\nif (item.lead) {\n  lead = item.lead;                 // Master Router sub-workflow call\n} else if (item.body) {\n  lead = item.body;                 // raw webhook POST\n} else {\n  lead = item;                      // already flat\n}\n\nconst clean = (v) => (v === undefined || v === null || v === false || v === '') ? null : String(v).trim();\n\nconst email = clean(lead.email);\nif (!email) {\n  throw new Error('Drip campaign aborted: no email address on the incoming lead. Payload keys: ' + Object.keys(item).join(', '));\n}\n\nreturn [{\n  json: {\n    name: clean(lead.name) || 'there',\n    email: email,\n    phone: clean(lead.phone) || clean(lead.whatsapp),\n    vehicle_interest: clean(lead.vehicle_interest) || clean(lead.vehicleInterest) || clean(lead.message) || 'a vehicle'\n  }\n}];"
      },
