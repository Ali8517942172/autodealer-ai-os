{
  "id": "VmnIXo7tM30zqawp",
  "name": "Slack Command Center - AI Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-command",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Slack Webhook (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        -160,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Slack slash commands arrive as form-encoded fields under .body\nconst raw = $input.first().json;\nconst b = raw.body || raw;\n\nconst command = String(b.text || raw.text || '').trim();\nif (!command) {\n  throw new Error('Empty Slack command. Usage: /nexus find lead ahmed');\n}\n\nreturn [{ json: {\n  command,\n  user: b.user_name || b.user_id || 'unknown',\n  channel: b.channel_name || b.channel_id || null\n} }];"
      },
      "id": "2",
      "name": "Extract Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.command }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "You are NEXUS OS CRM Agent. Parse the user's natural language Slack command and execute the appropriate CRM operation using the provided tools. Respond with a clear, concise confirmation suitable for a Slack message.",
          "maxIterations": 8,
          "enableStreaming": false
        }
      },
      "id": "3",
      "name": "AI CRM Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        464,
        304
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{json: {\n  response_type: 'in_channel',\n  blocks: [\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: `*Agent Confirmation:* \\n${$input.all()[0].json.output}`\n      }\n    }\n  ]\n}}];"
      },
      "id": "7",
      "name": "Format Slack Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        304
      ]
    },
    {
      "parameters": {
        "model": "={{ $json.orModel }}",
        "options": {
          "maxTokens": 1024,
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        336,
        512
      ],
      "id": "2f03e8b0-0c37-4aab-9dff-d5bd88726a83",
      "name": "OpenRouter Chat Model",
      "credentials": {
        "openRouterApi": {
          "id": "UUtKrBzkQOztAOzZ",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $fromAI('email', 'The exact email address of the lead whose status should be updated', 'string') }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ $fromAI('status', 'New status for the lead: HOT, WARM, COLD, CONTACTED, QUALIFIED, WON or LOST', 'string') }}"
            }
          ]
        }
      },
      "id": "8b96935a-144b-45aa-890d-a4c91816b47b",
      "name": "Update Lead Status",
      "type": "n8n-nodes-base.supabaseTool",
      "typeVersion": 1,
      "position": [
        608,
        512
      ],
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "leads",
        "limit": 20,
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "ilike",
              "keyValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('conditions0_Field_Value', `Partial or full lead NAME to search for, wrapped in % wildcards, e.g. %Ahmed%. Pass %% to ignore this filter.`, 'string') }}"
            },
            {
              "keyName": "email",
              "condition": "ilike",
              "keyValue": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('conditions1_Field_Value', `Partial or full lead EMAIL to search for, wrapped in % wildcards, e.g. %@gmail.com%. Pass %% to ignore this filter.`, 'string') }}"
            }
          ]
        }
      },
      "id": "25aaa5fe-3b20-4e96-bd0d-ee1fcc4cc829",
      "name": "Search Leads",
      "type": "n8n-nodes-base.supabaseTool",
      "typeVersion": 1,
      "position": [
        752,
