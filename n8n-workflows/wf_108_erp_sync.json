        464,
        304
      ],
      "id": "4ebb92c8-bdf4-4941-89f3-ab4dddf31b3b",
      "name": "Fetch HOT Leads from Supabase",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Map a NEXUS lead onto Bitrix24 crm.lead.add field shape.\n// Bitrix expects EMAIL/PHONE as arrays of {VALUE, VALUE_TYPE} objects.\nconst j = $json;\nconst lead = j.lead || j;\nconst score = (j.ai_decision && j.ai_decision.score) ?? lead.ai_score ?? 0;\n\nconst clean = (v) => (v === undefined || v === null || v === false || v === '') ? null : String(v);\nconst name = clean(lead.name) || 'Unknown lead';\nconst interest = clean(lead.vehicle_interest);\nconst email = clean(lead.email);\nconst phone = clean(lead.phone);\n\nconst fields = {\n  TITLE: interest ? name + ' - ' + interest : name + ' - NEXUS OS lead',\n  NAME: name,\n  OPPORTUNITY: Number(lead.budget_aed) || 0,\n  CURRENCY_ID: 'AED',\n  SOURCE_DESCRIPTION: clean(lead.source) || 'NEXUS OS',\n  COMMENTS: [\n    interest ? 'Vehicle interest: ' + interest : null,\n    'AI score: ' + score,\n    lead.source ? 'Source: ' + lead.source : null,\n    email ? 'Email: ' + email : null,\n    phone ? 'Phone: ' + phone : null,\n    'Synced automatically from NEXUS OS'\n  ].filter(Boolean).join('\\n')\n};\n\n// Only send contact arrays when a value exists - Bitrix rejects empty ones.\nif (email) fields.EMAIL = [{ VALUE: email, VALUE_TYPE: 'WORK' }];\nif (phone) fields.PHONE = [{ VALUE: phone, VALUE_TYPE: 'WORK' }];\n\nreturn { json: { fields: fields, params: { REGISTER_SONET_EVENT: 'Y' }, _lead_email: email, _lead_name: name } };"
      },
      "id": "071341a0-6aae-4402-b805-f966043c211d",
      "name": "Map Lead to Bitrix24 Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        304
      ]
    },
    {
      "parameters": {
