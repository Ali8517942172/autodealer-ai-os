    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BITRIX24_WEBHOOK_URL }}crm.lead.list.json",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { 'EMAIL': $json._lead_email || '__none__' }, select: ['ID'] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf108-find-01",
      "name": "Find Existing Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        304
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Bitrix has no upsert: crm.lead.add always creates a new record, so syncing\n// twice would duplicate every lead. Look the lead up by email first and decide\n// between update and add.\nconst found = (($json && $json.result) || [])[0] || null;\nconst mapped = $('Map Lead to Bitrix24 Lead').item.json;\nconst existingId = found ? Number(found.ID) : null;\n\n// crm.lead.update APPENDS to multi-value fields rather than replacing them, so\n// re-syncing an existing lead kept stacking duplicate phone/email entries.\n// Contact details are set once at creation; updates only refresh the sales data.\nconst fields = { ...mapped.fields };\nif (existingId) { delete fields.PHONE; delete fields.EMAIL; }\n\nreturn { json: {\n  existing_id: existingId,\n  fields: fields,\n  params: mapped.params,\n  _lead_email: mapped._lead_email,\n  _lead_name: mapped._lead_name\n} };"
      },
      "id": "wf108-decide-01",
      "name": "Decide Update or Create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "wf108-exists",
              "leftValue": "={{ !!$json.existing_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1232,
        304
      ],
      "id": "wf108-if-01",
      "name": "Already in Bitrix24?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BITRIX24_WEBHOOK_URL }}crm.lead.update.json",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.existing_id, fields: $json.fields, params: $json.params }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf108-upd-01",
      "name": "Update Bitrix24 Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
