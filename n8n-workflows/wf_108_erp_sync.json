        "url": "={{ $env.BITRIX24_WEBHOOK_URL }}crm.lead.add.json",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: $json.fields, params: $json.params }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf108-add-01",
      "name": "Create Bitrix24 Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1424,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalise the Bitrix24 response into an audit row.\nconst r = $json || {};\nconst d = $('Decide Update or Create').item.json;\nconst wasUpdate = !!d.existing_id;\nconst ok = wasUpdate ? (r.result === true) : !!r.result;\n\nlet reason = null;\nif (!ok) {\n  const raw = r.error ? (r.error.message || JSON.stringify(r.error)) : (r.error_description || r.error || 'unknown error');\n  const m = String(raw).match(/\\{.*\\}/s);\n  if (m) { try { const p = JSON.parse(m[0]); reason = p.error_description || p.error || String(raw); } catch (e) { reason = String(raw); } }\n  else { reason = String(raw); }\n  reason = reason.replace(/\\\\u0022/g, '\"').substring(0, 300);\n}\n\nconst id = wasUpdate ? d.existing_id : r.result;\nreturn { json: {\n  workflow: 'wf_108 ERP Sync - Bitrix24',\n  status: ok ? 'SUCCESS' : 'FAILED',\n  lead_name: d._lead_name || null,\n  lead_email: d._lead_email || null,\n  summary: ok\n    ? ('Bitrix24 lead ' + (wasUpdate ? 'updated' : 'created') + ' (ID ' + id + ')')\n    : ('Bitrix24 lead ' + (wasUpdate ? 'update' : 'creation') + ' failed: ' + reason)\n} };"
      },
      "id": "wf108-audit-01",
      "name": "Build Audit Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1616,
        304
      ]
    }
