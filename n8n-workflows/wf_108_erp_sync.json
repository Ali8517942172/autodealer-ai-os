      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        464,
        304
      ],
      "id": "4ebb92c8-bdf4-4941-89f3-ab4dddf31b3b",
      "name": "Fetch HOT Leads from Supabase",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "8680d994-3310-446e-b083-6941140e920b",
      "name": "Called by Master Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        256,
        480
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Two entry paths:\n//  - Webhook / scheduled backfill -> rows straight from the Supabase 'leads' table\n//  - Master Router sub-workflow    -> { lead: {...}, ai_decision: {...} }\n// Odoo's crm.lead model rejects any field name it does not know, so map\n// explicitly instead of auto-mapping the Supabase columns.\nconst j = $json;\nconst lead = j.lead || j;\nconst score = (j.ai_decision && j.ai_decision.score) ?? lead.ai_score ?? 0;\n\nconst clean = (v) => (v === undefined || v === null || v === false || v === '') ? null : v;\n\nconst name = clean(lead.name) || 'Unknown lead';\nconst interest = clean(lead.vehicle_interest);\n\n// Odoo priority is a selection: '0' Low, '1' Medium, '2' High, '3' Very High\nlet priority = '1';\nif (score >= 80) priority = '3';\nelse if (score >= 60) priority = '2';\nelse if (score < 30) priority = '0';\n\nreturn {\n  json: {\n    name: interest ? `${name} - ${interest}` : `${name} - NEXUS OS lead`,\n    contact_name: name,\n    email_from: clean(lead.email),\n    phone: clean(lead.phone),\n    expected_revenue: Number(lead.budget_aed) || 0,\n    priority: priority,\n    type: 'opportunity',\n    description: [\n      interest ? `Vehicle interest: ${interest}` : null,\n      `AI score: ${score}`,\n      lead.source ? `Source: ${lead.source}` : null,\n      'Synced from NEXUS OS'\n    ].filter(Boolean).join('\\n')\n  }\n};"
      },
      "id": "071341a0-6aae-4402-b805-f966043c211d",
      "name": "Map Lead to Odoo Opportunity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        304
      ]
    }
  ],
