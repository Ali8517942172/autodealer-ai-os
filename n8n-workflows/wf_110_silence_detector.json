        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_email: $('Loop Over Silent Leads').first().json.email, channel: 'system', direction: 'outbound', message: '[SILENCE-ESCALATED] Silent for ' + $('Loop Over Silent Leads').first().json.hours_silent + 'h since ' + $('Loop Over Silent Leads').first().json.last_outbound_at }) }}",
        "options": {}
