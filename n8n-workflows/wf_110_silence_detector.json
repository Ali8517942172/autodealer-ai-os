          "mappingMode": "defineBelow",
          "value": {
            "email": "={{ $json.email }}",
            "name": "={{ $json.name }}",
            "reason": "={{ 'No reply for ' + $json.hours_silent + ' hours since our last message' }}"
          }
        },
        "options": {
