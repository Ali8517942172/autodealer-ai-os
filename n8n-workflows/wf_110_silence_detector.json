    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "communication_logs",
        "returnAll": true,
        "orderBy": "created_at.desc"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "id": "p6-comms-0001",
      "name": "Fetch Recent Comms",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "jsCode": "// Phase 6: find leads that have gone quiet.\n// A lead is \"silent\" when:\n//   - it is still open (not WON/LOST/ESCALATED)\n//   - we sent them something at least SILENCE_HOURS ago\n//   - they have not replied since (no inbound message newer than our last outbound)\n//   - we have not already escalated them for silence\nconst SILENCE_HOURS = 12;\nconst cutoff = Date.now() - SILENCE_HOURS * 60 * 60 * 1000;\n\nconst leads = $('Fetch Open Leads').all().map(i => i.json).filter(l => l && l.email);\nconst logs  = $('Fetch Recent Comms').all().map(i => i.json).filter(l => l && l.lead_email);\n\nconst byLead = {};\nfor (const row of logs) {\n  const key = String(row.lead_email);\n  (byLead[key] = byLead[key] || []).push(row);\n}\n\nconst out = [];\nfor (const lead of leads) {\n  const rows = byLead[String(lead.email)] || [];\n  if (!rows.length) continue;\n\n  const ts = (r) => new Date(r.created_at || 0).getTime();\n  const outbound = rows.filter(r => r.direction === 'outbound').sort((a,b) => ts(b) - ts(a));\n  const inbound  = rows.filter(r => r.direction === 'inbound').sort((a,b) => ts(b) - ts(a));\n  if (!outbound.length) continue;\n\n  const lastOut = ts(outbound[0]);\n  const lastIn  = inbound.length ? ts(inbound[0]) : 0;\n\n  // Customer already replied after our last message -> not silent.\n  if (lastIn >= lastOut) continue;\n  // Not silent long enough yet.\n  if (lastOut > cutoff) continue;\n  // Already chased for silence -> don't spam the team every hour.\n  if (rows.some(r => String(r.message || '').startsWith('[SILENCE-ESCALATED]'))) continue;\n\n  out.push({ json: {\n    email: lead.email,\n    name: lead.name || null,\n    phone: lead.phone || null,\n    ai_score: lead.ai_score ?? null,\n    status: lead.status || null,\n    vehicle_interest: lead.vehicle_interest || null,\n    hours_silent: Math.floor((Date.now() - lastOut) / 3600000),\n    last_outbound_at: outbound[0].created_at,\n    last_outbound_message: String(outbound[0].message || '').substring(0, 300)\n  } });\n}\n\n// Highest-value silent leads first.\nout.sort((a, b) => (b.json.ai_score || 0) - (a.json.ai_score || 0));\nreturn out;"
      },
      "id": "p6-detect-0001",
      "name": "Find Silent Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "p6-loop-0001",
      "name": "Loop Over Silent Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "KI6P1Qcf3MIZakNa",
          "cachedResultName": "Lead Escalation - AI Agent"
        },
