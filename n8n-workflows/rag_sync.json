{
  "id": "dhy2DDjWUqwuzHLW",
  "name": "Sync Closed-Won Deals to Supabase pgvector",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deals/closed-won",
        "options": {}
      },
      "id": "1",
      "name": "Webhook - New Deal",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        256,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Webhook payloads arrive under .body; a sub-workflow call arrives flat.\n// The old Set node read the fields off the top level, so dealText came out\n// undefined and the embedding API rejected the request with a 400.\nconst raw = $input.first().json;\nconst d = raw.body || raw.deal || raw;\n\nconst dealId = String(d.deal_id || d.dealId || d.id || '').trim();\nif (!dealId) throw new Error('Rejected: closed-won deal has no deal_id. Keys received: ' + Object.keys(d).join(', '));\n\nconst parts = [\n  d.customer_name ? 'Customer: ' + d.customer_name : null,\n  d.vehicle ? 'Vehicle: ' + d.vehicle : null,\n  (d.amount_aed !== undefined && d.amount_aed !== null) ? 'Deal value: AED ' + d.amount_aed : null,\n  d.notes ? 'Notes: ' + d.notes : null\n].filter(Boolean);\n\nconst dealText = parts.join('. ');\nif (!dealText) throw new Error('Rejected: deal ' + dealId + ' produced no text to embed.');\n\nreturn [{ json: { dealId, dealText } }];"
      },
      "id": "2",
      "name": "Format Deal Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "HTTP-Referer",
              "value": "https://nexuscorp.net"
            },
            {
              "name": "X-Title",
              "value": "NEXUS OS - RAG Embeddings"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'openai/text-embedding-ada-002', input: $json.dealText }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "3",
      "name": "OpenRouter - Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        656,
        304
      ],
      "credentials": {
        "openRouterApi": {
          "id": "UUtKrBzkQOztAOzZ",
          "name": "OpenRouter account"
        }
      },
      "continueOnFail": true,
      "onError": "stopWorkflow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst dealId = $('Format Deal Text').first().json.dealId;\nconst dealText = $('Format Deal Text').first().json.dealText;\n\nconst embedding = response?.data?.[0]?.embedding;\n\n// Never fall back to a zero vector: writing 1536 zeros into pgvector silently\n// poisons the knowledge base and every similarity search after it. Fail loudly.\nif (!Array.isArray(embedding) || embedding.length !== 1536) {\n  throw new Error(\n    'Embedding generation failed for deal ' + dealId + '. ' +\n    'Nothing was written to deals_embeddings. Response: ' +\n    JSON.stringify(response).substring(0, 400)\n  );\n}\n\nreturn [{ json: { dealId, dealText, embedding: JSON.stringify(embedding) } }];"
      },
      "id": "parse-embedding",
      "name": "Parse Embedding Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dsvuoovivysszdoiorch.supabase.co/rest/v1/deals_embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "deal_id"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ '{\"deal_id\":' + JSON.stringify(String($json.dealId)) + ',\"content\":' + JSON.stringify($json.dealText) + ',\"embedding\":' + $json.embedding + '}' }}",
        "options": {}
      },
      "id": "4",
      "name": "Supabase (Postgres) - Upsert Vector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1056,
        304
      ],
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dsvuoovivysszdoiorch.supabase.co/rest/v1/audit_log",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'Sync Closed-Won to pgvector', status: 'SUCCESS', lead_name: ($json.lead_name || $json.name || null), lead_email: ($json.lead_email || $json.email || null), summary: 'Completed', logged_at: $now.toISO() }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "audit-rag_sync.jso",
      "name": "Audit Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        600
      ],
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
