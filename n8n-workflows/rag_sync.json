{
  "id": "dhy2DDjWUqwuzHLW",
  "name": "Sync Closed-Won Deals to Supabase pgvector",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deals/closed-won",
        "options": {}
      },
      "id": "1",
      "name": "Webhook - New Deal",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        256,
        304
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify((() => { const b = $json.body || $json; if (!b.id) { throw new Error('Deal sync requires an \"id\" field on the payload.'); } const parts = [b.deal_name, b.company, b.description].filter(Boolean); if (!parts.length) { throw new Error('Deal ' + b.id + ' has no deal_name, company or description to embed.'); } return { dealId: String(b.id), dealText: parts.join(' - ') }; })()) }}",
        "options": {}
      },
      "id": "2",
      "name": "Format Deal Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "HTTP-Referer",
              "value": "https://nexuscorp.net"
            },
            {
              "name": "X-Title",
              "value": "NEXUS OS - RAG Embeddings"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'openai/text-embedding-ada-002', input: $json.dealText }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "3",
      "name": "OpenRouter - Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        656,
        304
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "DSkhGhMjUxdWrTTR",
          "name": "Header Auth account"
        },
        "openRouterApi": {
          "id": "UUtKrBzkQOztAOzZ",
          "name": "OpenRouter account"
        }
      },
      "continueOnFail": true,
      "onError": "stopWorkflow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst dealId = $('Format Deal Text').first().json.dealId;\nconst dealText = $('Format Deal Text').first().json.dealText;\n\nconst embedding = response?.data?.[0]?.embedding;\n\n// Never fall back to a zero vector: writing 1536 zeros into pgvector silently\n// poisons the knowledge base and every similarity search after it. Fail loudly.\nif (!Array.isArray(embedding) || embedding.length !== 1536) {\n  throw new Error(\n    'Embedding generation failed for deal ' + dealId + '. ' +\n    'Nothing was written to deals_embeddings. Response: ' +\n    JSON.stringify(response).substring(0, 400)\n  );\n}\n\nreturn [{ json: { dealId, dealText, embedding: JSON.stringify(embedding) } }];"
      },
      "id": "parse-embedding",
      "name": "Parse Embedding Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dsvuoovivysszdoiorch.supabase.co/rest/v1/deals_embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "deal_id"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ '{\"deal_id\":' + JSON.stringify(String($json.dealId)) + ',\"content\":' + JSON.stringify($json.dealText) + ',\"embedding\":' + $json.embedding + '}' }}",
        "options": {}
      },
      "id": "4",
      "name": "Supabase (Postgres) - Upsert Vector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1056,
        304
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "ewCXyGq2VCV76foT",
          "name": "Custom Auth account"
        },
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      }
    }
  ],
  "connections": {
    "Webhook - New Deal": {
      "main": [
        [
          {
            "node": "Format Deal Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Deal Text": {
      "main": [
        [
          {
            "node": "OpenRouter - Generate Embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenRouter - Generate Embedding": {
      "main": [
        [
          {
            "node": "Parse Embedding Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Embedding Response": {
      "main": [
        [
          {
            "node": "Supabase (Postgres) - Upsert Vector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "binaryMode": "separate",
    "timezone": "Asia/Dubai",
    "saveDataErrorExecution": "all"
  }
}
